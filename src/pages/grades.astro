---
import TopNav from '../components/TopNav.astro';

const grades = [
  { n: 6, href: '/grades/6', color: '#E6F1FB', border: '#B5D4F4', text: '#042C53', ready: true },
  { n: 7, href: '/grades/7', color: '#B5D4F4', border: '#B5D4F4', text: '#042C53', ready: false },
  { n: 8, href: '/grades/8', color: '#85B7EB', border: '#85B7EB', text: '#042C53', ready: false },
  { n: 9, href: '/grades/9', color: '#378ADD', border: '#378ADD', text: '#fff', ready: false },
  { n: 10, href: '/grades/10', color: '#185FA5', border: '#185FA5', text: '#fff', ready: false },
  { n: 11, href: '/grades/11', color: '#0C447C', border: '#0C447C', text: '#fff', ready: false },
  { n: 12, href: '/grades/12', color: '#042C53', border: '#042C53', text: '#fff', ready: false },
];
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="generator" content={Astro.generator} />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<title>Grade Pages — Six Years Out</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500&display=swap">
</head>
<body>
<TopNav current="grades" />

<header class="page-head">
  <span class="eyebrow">Grade pages</span>
  <h1>One page per grade</h1>
  <p>Going deeper on the same four sections you see on the timeline — what to do now, what most people get wrong, what counts, and tests and deadlines. 6th grade is up first; the rest are on the way.</p>
</header>

<section class="grades-row">
  {grades.map((g) => (
    g.ready ? (
      <a class="grade-dot ready" href={g.href} style={`background:${g.color};border-color:${g.border};color:${g.text}`}>
        {g.n}
      </a>
    ) : (
      <span class="grade-dot" style={`background:${g.color};border-color:${g.border};color:${g.text}`}>
        {g.n}
      </span>
    )
  ))}
</section>

<a class="back" href="/timeline">← Back to the timeline</a>

<style>
:root{
  --paper:#FAF4EA;
  --ink:#12283D;
  --ink-soft:#4A5C70;
  --ink-faint:#7A8899;
  --rule:#E4D9C6;
  --g6:#E6F1FB;
  --g7:#B5D4F4;
  --g8:#85B7EB;
  --g9:#378ADD;
  --g10:#185FA5;
  --g11:#0C447C;
  --g12:#042C53;
}
*{box-sizing:border-box}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:Inter,system-ui,sans-serif;
  font-size:16px;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
.page-head{max-width:560px;margin:0 auto;padding:96px 24px 8px;text-align:center}
.eyebrow{display:block;font-size:13px;font-weight:500;color:var(--g10);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:16px}
.page-head h1{font-family:Fraunces,serif;font-weight:700;font-size:34px;line-height:1.2;margin:0 0 16px;letter-spacing:-0.01em;text-wrap:balance}
.page-head p{font-size:15.5px;line-height:1.6;color:var(--ink-soft);margin:0 0 8px}

.grades-row{
  max-width:640px;margin:48px auto 0;padding:0 24px;
  display:flex;justify-content:center;gap:14px;flex-wrap:wrap;
}
.grade-dot{
  width:52px;height:52px;border-radius:50%;border:1px solid transparent;
  display:flex;align-items:center;justify-content:center;
  font-family:Fraunces,serif;font-weight:600;font-size:19px;
  text-decoration:none;opacity:0.45;
}
.grade-dot.ready{opacity:1;box-shadow:0 1px 3px rgba(4,44,83,0.15)}
.grade-dot.ready:hover{transform:translateY(-2px)}
.grade-dot.ready:focus-visible{outline:2px solid var(--g10);outline-offset:3px}

.back{display:block;text-align:center;margin:56px auto 0;font-size:14px;color:var(--g10);text-decoration:none;font-weight:500;padding-bottom:120px}
.back:hover{text-decoration:underline}
.back:focus-visible{outline:2px solid var(--g10);outline-offset:3px}

@media (max-width:640px){
  .page-head{padding:64px 20px 8px}
  .page-head h1{font-size:28px}
  .grade-dot{width:44px;height:44px;font-size:16px}
  .back{padding-bottom:80px}
}
</style>
</body>
</html>
