---
import TopNav from '../components/TopNav.astro';
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="generator" content={Astro.generator} />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<title>Six Years Out</title>
	<meta name="description" content="Everything schools tell you about college, they tell you too late. Six Years Out lays it out early — grade by grade, starting six years before anyone tells you to think about it." />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500&display=swap">
</head>
<body>

<TopNav current="home" />

<header class="hero">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-inner">
    <h1>You're six years out.<br>Or seven. Or four.</h1>
    <p class="hero-lede">But none of that changes the fact that college is looming closer. Everything schools tell you about college, they tell you too late. With tools from a laid-out timeline to SAT study resources, Six Years Out helps you feel prepared, so nothing catches you by surprise on the way.</p>
  </div>
</header>

<section class="statement">
  <p>MOST COLLEGE ADVICE<br>IS WRITTEN FOR<br><span class="accent">PARENTS OF JUNIORS.</span></p>
  <p class="statement-sub">This is written for the student, starting years before most even think about college, and while there's still time to do something with what you learn.</p>
</section>

<section class="start">
  <div class="start-card">
    <span class="eyebrow">New here?</span>
    <h2>Start on the timeline.</h2>
    <p>One page, seven grades, top to bottom. What to do now, what most people get wrong, what actually counts, and what tests and deadlines are coming — for wherever you are on the line.</p>
    <a class="cta" href="/timeline">See the timeline →</a>
  </div>
</section>

<footer class="site-foot">
  <p>Six Years Out is written by Kenzie, 8th grade.</p>
</footer>

<style>
:root{
  --paper:#FAF4EA;
  --ink:#12283D;
  --ink-soft:#4A5C70;
  --ink-faint:#7A8899;
  --rule:#E4D9C6;
  --g6:#E6F1FB;
  --g7:#B5D4F4;
  --g8:#85B7EB;
  --g9:#378ADD;
  --g10:#185FA5;
  --g11:#0C447C;
  --g12:#042C53;
}
*{box-sizing:border-box}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:Inter,system-ui,sans-serif;
  font-size:16px;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}

/* hero */
.hero{position:relative;background:var(--g11);color:#fff;overflow:hidden}
.hero-grid{
  position:absolute;inset:0;
  background-image: radial-gradient(rgba(255,255,255,0.18) 1.5px, transparent 1.5px);
  background-size:32px 32px;
  mask-image:linear-gradient(to bottom, #000 0%, transparent 85%);
}
.hero-inner{position:relative;max-width:720px;margin:0 auto;padding:100px 24px 96px;text-align:center}
.hero h1{
  font-family:Fraunces,serif;font-weight:700;font-size:56px;line-height:1.08;
  margin:0 0 22px;letter-spacing:-0.01em;
}
.hero-lede{font-size:17px;line-height:1.6;color:#C9D8E8;max-width:520px;margin:0 auto 34px}
.cta{
  display:inline-block;font-family:Inter,sans-serif;font-weight:500;font-size:15px;
  padding:13px 26px;border-radius:9px;background:var(--g8);color:var(--g12);
  text-decoration:none;
}
.cta:hover{background:#fff}
.cta:focus-visible{outline:2px solid #fff;outline-offset:3px}

/* statement */
.statement{max-width:640px;margin:0 auto;padding:88px 24px;text-align:center}
.statement p:first-child{
  font-family:Fraunces,serif;font-weight:600;font-size:34px;line-height:1.2;
  margin:0 0 24px;color:var(--ink);
}
.statement .accent{color:var(--g10)}
.statement-sub{font-size:16px;line-height:1.6;color:var(--ink-soft);margin:0 auto;max-width:460px}

/* start here */
.start{padding:0 24px 100px}
.start-card{
  max-width:640px;margin:0 auto;padding:44px;border-radius:16px;
  background:#fff;border:1px solid var(--rule);text-align:center;
}
.eyebrow{display:block;font-size:13px;font-weight:500;color:var(--g10);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:10px}
.start-card h2{font-family:Fraunces,serif;font-weight:600;font-size:28px;margin:0 0 14px}
.start-card p{font-size:15px;line-height:1.6;color:var(--ink-soft);margin:0 0 28px}
.start-card .cta{background:var(--g10);color:#fff}
.start-card .cta:hover{background:var(--g11)}

/* footer */
.site-foot{text-align:center;padding:0 24px 56px;font-size:13px;color:var(--ink-faint)}

@media (max-width:640px){
  .hero-inner{padding:72px 20px 64px}
  .hero h1{font-size:38px}
  .statement{padding:64px 20px}
  .statement p:first-child{font-size:26px}
  .start-card{padding:32px 24px}
}
@media (prefers-reduced-motion:reduce){
  *{transition:none!important;animation:none!important}
}
</style>
</body>
</html>
