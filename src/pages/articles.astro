---
import TopNav from '../components/TopNav.astro';
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="generator" content={Astro.generator} />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<title>Articles — Six Years Out</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500&display=swap">
</head>
<body>
<TopNav current="articles" />

<header class="page-head">
  <span class="eyebrow">Articles</span>
  <h1>Everything we've written so far</h1>
</header>

<section class="articles">
  <div class="articles-grid">
    <a class="article-card" href="/study-resources">
      <h3>Resources</h3>
      <p>SAT and ACT prep resources, ranked with an actual opinion.</p>
      <span class="read-more">Read more →</span>
    </a>
    <a class="article-card" href="/application">
      <h3>What's actually on a college application?</h3>
      <p>The artifact itself, demystified.</p>
      <span class="read-more">Read more →</span>
    </a>
    <a class="article-card" href="/uniqueness">
      <h3>Why you shouldn't do things just for your college application</h3>
      <p>The trade-offs of resume-stuffing, and what to do instead.</p>
      <span class="read-more">Read more →</span>
    </a>
  </div>
</section>

<style>
:root{
  --paper:#FAF4EA;
  --ink:#12283D;
  --ink-soft:#4A5C70;
  --ink-faint:#7A8899;
  --rule:#E4D9C6;
  --g6:#E6F1FB;
  --g7:#B5D4F4;
  --g8:#85B7EB;
  --g9:#378ADD;
  --g10:#185FA5;
  --g11:#0C447C;
  --g12:#042C53;
}
*{box-sizing:border-box}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:Inter,system-ui,sans-serif;
  font-size:16px;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
.page-head{max-width:640px;margin:0 auto;padding:80px 24px 48px;text-align:center}
.eyebrow{display:block;font-size:13px;font-weight:500;color:var(--g10);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:14px}
.page-head h1{font-family:Fraunces,serif;font-weight:700;font-size:34px;line-height:1.2;margin:0;letter-spacing:-0.01em;text-wrap:balance}

.articles{padding:0 24px 120px}
.articles-grid{max-width:1040px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.article-card{
  display:flex;flex-direction:column;padding:28px;border-radius:14px;
  background:#fff;border:1px solid var(--rule);text-decoration:none;color:var(--ink);
}
.article-card:hover{border-color:var(--g10)}
.article-card:focus-visible{outline:2px solid var(--g10);outline-offset:3px}
.article-card h3{font-family:Fraunces,serif;font-weight:600;font-size:18px;line-height:1.35;margin:0 0 10px}
.article-card p{font-size:14px;line-height:1.55;color:var(--ink-soft);margin:0 0 18px;flex:1}
.article-card .read-more{font-size:13px;font-weight:500;color:var(--g10)}

@media (max-width:820px){
  .articles-grid{grid-template-columns:1fr}
}
@media (max-width:640px){
  .page-head{padding:56px 20px 40px}
  .page-head h1{font-size:28px}
}
</style>
</body>
</html>
