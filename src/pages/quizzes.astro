---
import TopNav from '../components/TopNav.astro';
import SEO from '../components/SEO.astro';
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="generator" content={Astro.generator} />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<SEO
		title="College Prep Quizzes: SAT vs ACT & More — Six Years Out"
		description="Quick quizzes to help you figure out where you stand — starting with SAT vs ACT. No accounts, nothing saved, nothing tracked."
		path="/quizzes"
	/>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500&display=swap">
</head>
<body>
<TopNav current="quizzes" />

<header class="page-head">
  <span class="eyebrow">Quizzes</span>
  <h1>Figure out where you stand</h1>
  <p>Short, no-accounts-needed quizzes. Your result encodes right into the URL, so it's yours to bookmark or share — nothing saved, nothing tracked.</p>
</header>

<section class="quiz-list">
  <a class="quiz-card" href="/quizzes/sat-act">
    <h2>SAT vs ACT</h2>
    <p>8 questions, 5 minutes, and a little bit of brain power. Find out which test actually fits you.</p>
    <span class="read-more">Take the quiz →</span>
  </a>
  <div class="quiz-card soon">
    <span class="eyebrow">Coming soon</span>
    <h2>What kind of school fits you?</h2>
    <p>No school names required — just a shape: size, cost, selectivity, setting, and how central your thing is on campus.</p>
  </div>
</section>

<a class="back" href="/timeline">← Back to the timeline</a>

<style>
:root{
  --paper:#FAF4EA;
  --ink:#12283D;
  --ink-soft:#4A5C70;
  --ink-faint:#7A8899;
  --rule:#E4D9C6;
  --g6:#E6F1FB;
  --g7:#B5D4F4;
  --g8:#85B7EB;
  --g9:#378ADD;
  --g10:#185FA5;
  --g11:#0C447C;
  --g12:#042C53;
}
*{box-sizing:border-box}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:Inter,system-ui,sans-serif;
  font-size:16px;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
.page-head{max-width:560px;margin:0 auto;padding:96px 24px 8px;text-align:center}
.eyebrow{display:block;font-size:13px;font-weight:500;color:var(--g10);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:16px}
.page-head h1{font-family:Fraunces,serif;font-weight:700;font-size:34px;line-height:1.2;margin:0 0 16px;letter-spacing:-0.01em;text-wrap:balance}
.page-head p{font-size:15.5px;line-height:1.6;color:var(--ink-soft);margin:0 0 8px}

.quiz-list{max-width:640px;margin:48px auto 0;padding:0 24px;display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.quiz-card{
  display:block;padding:28px;border-radius:14px;
  background:#fff;border:1px solid var(--rule);text-decoration:none;color:var(--ink);
}
.quiz-card:not(.soon):hover{border-color:var(--g10)}
.quiz-card:not(.soon):focus-visible{outline:2px solid var(--g10);outline-offset:3px}
.quiz-card.soon{opacity:0.6}
.quiz-card .eyebrow{margin-bottom:10px}
.quiz-card h2{font-family:Fraunces,serif;font-weight:600;font-size:19px;margin:0 0 10px;line-height:1.3}
.quiz-card p{font-size:14px;line-height:1.55;color:var(--ink-soft);margin:0 0 16px}
.quiz-card .read-more{font-size:13px;font-weight:500;color:var(--g10)}

.back{display:block;text-align:center;margin:56px auto 0;font-size:14px;color:var(--g10);text-decoration:none;font-weight:500;padding-bottom:120px}
.back:hover{text-decoration:underline}
.back:focus-visible{outline:2px solid var(--g10);outline-offset:3px}

@media (max-width:640px){
  .page-head{padding:64px 20px 8px}
  .page-head h1{font-size:28px}
  .quiz-list{grid-template-columns:1fr}
  .back{padding-bottom:80px}
}
</style>
</body>
</html>
