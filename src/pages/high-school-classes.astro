</article>

<style>
:root{
  --paper:#FAF4EA;
  --ink:#12283D;
  --ink-soft:#4A5C70;
  --ink-faint:#7A8899;
  --rule:#E4D9C6;
  --g6:#E6F1FB;
  --g7:#B5D4F4;
  --g8:#85B7EB;
  --g9:#378ADD;
  --g10:#185FA5;
  --g11:#0C447C;
  --g12:#042C53;
}
*{box-sizing:border-box}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:Inter,system-ui,sans-serif;
  font-size:16px;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
.post{max-width:640px;margin:0 auto;padding:80px 24px 120px}
.post-head{text-align:center;margin-bottom:48px}
.eyebrow{display:block;font-size:13px;font-weight:500;color:var(--g10);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:14px}
.post-head h1{font-family:Fraunces,serif;font-weight:700;font-size:34px;line-height:1.2;margin:0 0 14px;letter-spacing:-0.01em;text-wrap:balance}
.dek{font-size:16px;line-height:1.6;color:var(--ink-soft);margin:0}

.post-body p{font-size:15.5px;line-height:1.7;color:var(--ink);margin:0 0 20px}
.post-body h2{font-family:Fraunces,serif;font-weight:600;font-size:22px;color:var(--g10);margin:40px 0 16px}
.post-body h3{font-family:Fraunces,serif;font-weight:600;font-size:17px;color:var(--ink);margin:0 0 14px}
.post-body em{font-style:normal;font-weight:600}

.table-wrap{overflow-x:auto;margin:0 0 16px;border:1px solid var(--rule);border-radius:10px}
.course-table{width:100%;border-collapse:collapse;background:#fff;font-size:13.5px}
.course-table th,.course-table td{padding:10px 14px;text-align:left;white-space:nowrap;border-bottom:1px solid var(--rule)}
.course-table thead th{
  background:var(--g11);color:#fff;font-family:Inter,sans-serif;font-weight:500;
  font-size:12.5px;text-transform:uppercase;letter-spacing:0.04em;white-space:nowrap;
}
.course-table tbody th{font-family:Fraunces,serif;font-weight:600;font-size:14px;color:var(--ink);white-space:nowrap}
.course-table tbody tr:last-child td,.course-table tbody tr:last-child th{border-bottom:none}
.course-table td.no-target{
  white-space:normal;color:var(--ink-soft);font-style:italic;font-size:13px;
}
.table-note,.table-source{font-size:13.5px;line-height:1.6;color:var(--ink-faint);margin:0 0 16px}
.table-source a{color:var(--g10)}
.callout{
  margin:0 0 20px;padding:18px 20px;border-radius:10px;
  background:var(--g6);border:1px solid var(--g7);
  font-size:14.5px;line-height:1.6;color:var(--g12);
}
.callout strong{font-weight:600}

.back{display:inline-block;margin-top:8px;font-size:14px;color:var(--g10);text-decoration:none;font-weight:500}
.back:hover{text-decoration:underline}
.back:focus-visible{outline:2px solid var(--g10);outline-offset:3px}

@media (max-width:640px){
  .post{padding:56px 20px 96px}
  .post-head h1{font-size:28px}
  .post-body h2{font-size:20px}
}
</style>
