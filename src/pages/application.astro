---
import TopNav from '../components/TopNav.astro';
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="generator" content={Astro.generator} />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<title>The Application — Six Years Out</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500&display=swap">
</head>
<body>
<TopNav current="application" />

<section class="placeholder">
  <span class="eyebrow">Coming soon</span>
  <h1>What's actually on a college application</h1>
  <p>The artifact itself, demystified — every section, what it's really asking, and what to do with that years before it matters.</p>
  <a class="back" href="/timeline">← Back to the timeline</a>
</section>

<style>
:root{
  --paper:#FAF4EA;
  --ink:#12283D;
  --ink-soft:#4A5C70;
  --ink-faint:#7A8899;
  --rule:#E4D9C6;
  --g6:#E6F1FB;
  --g7:#B5D4F4;
  --g8:#85B7EB;
  --g9:#378ADD;
  --g10:#185FA5;
  --g11:#0C447C;
  --g12:#042C53;
}
*{box-sizing:border-box}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:Inter,system-ui,sans-serif;
  font-size:16px;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
.placeholder{max-width:560px;margin:0 auto;padding:120px 24px 140px;text-align:center}
.eyebrow{display:block;font-size:13px;font-weight:500;color:var(--g10);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:16px}
.placeholder h1{font-family:Fraunces,serif;font-weight:700;font-size:34px;line-height:1.2;margin:0 0 16px;letter-spacing:-0.01em;text-wrap:balance}
.placeholder p{font-size:15.5px;line-height:1.6;color:var(--ink-soft);margin:0 0 32px}
.back{font-size:14px;color:var(--g10);text-decoration:none;font-weight:500}
.back:hover{text-decoration:underline}
.back:focus-visible{outline:2px solid var(--g10);outline-offset:3px}

@media (max-width:640px){
  .placeholder{padding:80px 20px 96px}
  .placeholder h1{font-size:28px}
}
</style>
</body>
</html>
